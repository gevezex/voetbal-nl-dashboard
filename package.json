{
  "name": "voetbal-nl-extension",
  "version": "1.0.1",
  "private": true,
  "description": "Chrome-extensie die van elke KNVB-jeugdpoule op voetbal.nl een statistisch analyse-dashboard maakt.",
  "scripts": {
    "build:ext": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "assets:generate": "node scripts/generate-store-assets.mjs",
    "package": "pnpm build:ext && node scripts/package-extension.mjs",
    "release": "pnpm typecheck && pnpm package",
    "bump": "node scripts/new-version.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.2.2"
}
