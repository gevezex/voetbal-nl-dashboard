{
  "manifest_version": 3,
  "name": "Voetbal Poule Dashboard",
  "version": "0.9.0",
  "description": "Maak van elke KNVB-jeugdpoule een statistisch dashboard met voorspellingen en onderlinge vergelijkingen.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.voetbal.nl/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voetbal Poule Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.voetbal.nl/team/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
